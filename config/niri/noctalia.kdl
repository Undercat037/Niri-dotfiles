layout {

    focus-ring {
        active-color   "#ffb68c"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb68c"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb68c"
        inactive-color "#753400"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb68c80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb68c"
        urgent-color "#ffb4ab"
    }
}
