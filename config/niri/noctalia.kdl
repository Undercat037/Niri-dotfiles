layout {

    focus-ring {
        active-color   "#879a39"
        inactive-color "#100f0f"
        urgent-color   "#d14d41"
    }

    border {
        active-color   "#879a39"
        inactive-color "#100f0f"
        urgent-color   "#d14d41"
    }


    tab-indicator {
        active-color   "#879a39"
        inactive-color "#333b12"
        urgent-color   "#d14d41"
    }

    insert-hint {
        color "#879a3980"
    }
}

recent-windows {
    highlight {
        active-color "#879a39"
        urgent-color "#d14d41"
    }
}
