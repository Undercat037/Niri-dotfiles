layout {

    focus-ring {
        active-color   "#ffb3b4"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb3b4"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb3b4"
        inactive-color "#7e2931"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb3b480"
    }
}

recent-windows {
    highlight {
        active-color "#ffb3b4"
        urgent-color "#ffb4ab"
    }
}
