// Permanent Workspaces
workspace "1"
workspace "2"
workspace "3"

binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── noctalia-shell keybinds ───
    // https://docs.noctalia.dev/getting-started/keybinds/

    // Super+Shift+ESCAPE                 { show-hotkey-overlay; }

    // ─── Applications ───
    Super+T                               hotkey-overlay-title="Open Terminal: kitty " { spawn "kitty"; }
    Super+Ctrl+T                          hotkey-overlay-title="Open Terminal: footclient " { spawn "footclient"; }
    Super+Alt+T                           hotkey-overlay-title="Open Terminal: foot " { spawn "foot"; }
    Super+Alt+Ctrl+T                      hotkey-overlay-title="Open Terminal: foot server restart " { spawn "sh" "-c" "pkill -f 'foot --server'; foot --server"; }

    Super+Q                               { close-window; }
    Super+Shift+Q                         { spawn-sh "pkill -9 gamescope"; }

    Super+Z                               hotkey-overlay-title="Open Browser: zen" { spawn "zen-browser"; }
    Super+Ctrl+Z                          hotkey-overlay-title="Open Browser: firefox" { spawn "firefox"; }
    Super+Shift+Ctrl+Z                    hotkey-overlay-title="Open Browser Private: zen" { spawn "zen-browser" "--private-window"; }

    Super+C                               hotkey-overlay-title="Open TG: AyuGram" { spawn "AyuGram"; }
    Super+Ctrl+C                          hotkey-overlay-title="Open IDE: zed" { spawn "sh" "-c" "zeditor"; }
    Super+Shift+C                         hotkey-overlay-title="Open IDE: vscode" { spawn "sh" "-c" "code --ozone-platform=wayland"; }
    Super+Ctrl+Alt+C                      hotkey-overlay-title="Open Taskmgr: missioncenter" { spawn "missioncenter"; }
    Super+Alt+C                           hotkey-overlay-title="Open Taskmgr: stacer" { spawn "stacer"; }

    Super+N                               hotkey-overlay-title="File Manager: Nautilus" { spawn-sh "nautilus --new-window"; }
    Super+Alt+N                           hotkey-overlay-title="File Manager: Nemo" { spawn "nemo"; }

    Ctrl+F9                               hotkey-overlay-title="OBS record start" { spawn "obs-cmd" "recording" "start"; }
    Ctrl+F10                              hotkey-overlay-title="OBS record stop" { spawn "obs-cmd" "recording" "stop"; }

    Super+Y                               hotkey-overlay-title="Open sound pad: pwvucontrol" { spawn "pwvucontrol"; }
    Super+Ctrl+Y                          hotkey-overlay-title="Open sound pad: pwvucontrol" { spawn "pavucontrol"; }
    Super+Alt+Y                           hotkey-overlay-title="color picker" { spawn "sh" "-c" "hyprpicker | wl-copy"; }

    // -------------NOCTALIA v5------------

    Super+ALT+L                           hotkey-overlay-title="Lock Screen: noctalia lock" { spawn-sh "noctalia msg session lock"; }
    Super+Escape                          hotkey-overlay-title="Session Menu: noctalia sessionMenu" { spawn-sh "noctalia msg panel-toggle session"; }

    Super+R                               hotkey-overlay-title="noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+Shift+R                         hotkey-overlay-title="noctalia launcher command" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+Ctrl+R                          hotkey-overlay-title="noctalia launcher windows" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+Alt+R                           hotkey-overlay-title="noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }

    Super+M                               hotkey-overlay-title="noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }
    Super+Ctrl+M                          hotkey-overlay-title="noctalia desktop widgets edit" { spawn-sh "noctalia msg desktop-widgets-edit"; }
    Super+Alt+M                           hotkey-overlay-title="noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }

    Super+V                               hotkey-overlay-title="noctalia clipboard" { spawn-sh "noctalia msg panel-toggle clipboard"; }

    Super+U                               hotkey-overlay-title="noctalia wall" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Super+Ctrl+U                          hotkey-overlay-title="noctalia wall rand" { spawn-sh "noctalia msg wallpaper-random"; }

    Super+P                               hotkey-overlay-title="Restart Noctalia" { spawn-sh "pkill -x noctalia; noctalia"; }

    Super+I                               hotkey-overlay-title="Cheatsheet" { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }

    Super+Alt+B                           hotkey-overlay-title="calendar" { spawn-sh "noctalia msg panel-toggle control-center calendar"; }
    Super+Ctrl+B                          hotkey-overlay-title="notifications history" { spawn-sh "noctalia msg panel-toggle control-center notifications"; }
    Super+B                               hotkey-overlay-title="noctalia control" { spawn-sh "noctalia msg panel-toggle control-center"; }

    Super+F11                             hotkey-overlay-title="Monitor off" { spawn-sh "noctalia msg dpms-off"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume                  allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                  allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                         allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                      allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                         allow-when-locked=true { spawn-sh "noctalia msg media-next"; }
    XF86AudioPrev                         allow-when-locked=true { spawn-sh "noctalia msg media-previous"; }
    XF86AudioPlay                         allow-when-locked=true { spawn-sh "noctalia msg media-play-pause"; }
    XF86AudioPause                        allow-when-locked=true { spawn-sh "noctalia msg media-play-pause"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown                 allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───

    Super+Left                            { focus-column-left; }
    Super+A                               { focus-column-left; }

    Super+Right                           { focus-column-right; }
    Super+D                               { focus-column-right; }

    Super+Up                              { focus-window-up; }
    Super+W                               { focus-workspace-up; }

    Super+Down                            { focus-window-down; }
    Super+S                               { focus-workspace-down; }



    Super+Shift+Left                      { move-column-left; }
    Super+Shift+A                         { move-column-left; }

    Super+Shift+Right                     { move-column-right; }
    Super+Shift+D                         { move-column-right; }

    Super+Shift+UP                        { move-window-up; }
    Super+Alt+W                           { move-window-up; }
    Super+Shift+W                         { move-window-to-workspace-up; }

    Super+Shift+Down                      { move-window-down; }
    Super+Alt+S                           { move-window-down; }
    Super+Shift+S                         { move-window-to-workspace-down; }



    // ─── Workspace Switching ───
    Super+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Super+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Super+CTRL+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Super+CTRL+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Super+WheelScrollRight                { focus-column-right; }
    Super+WheelScrollLeft                 { focus-column-left; }
    Super+CTRL+WheelScrollRight           { move-column-right; }
    Super+CTRL+WheelScrollLeft            { move-column-left; }

    Super+Shift+WheelScrollDown           { focus-column-right; }
    Super+Shift+WheelScrollUp             { focus-column-left; }
    Super+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Super+CTRL+Shift+WheelScrollUp        { move-column-left; }




    Super+Grave                           { focus-workspace 10; }
    Super+1                               { focus-workspace 1; }
    Super+2                               { focus-workspace 2; }
    Super+3                               { focus-workspace 3; }
    Super+4                               { focus-workspace 4; }
    Super+5                               { focus-workspace 5; }
    Super+6                               { focus-workspace 6; }
    Super+7                               { focus-workspace 7; }
    Super+8                               { focus-workspace 8; }
    Super+9                               { focus-workspace 9; }
    Super+0                               { focus-workspace 10; }


    Super+Shift+Grave                     { move-column-to-workspace 10; }
    Super+Shift+1                         { move-column-to-workspace 1; }
    Super+Shift+2                         { move-column-to-workspace 2; }
    Super+Shift+3                         { move-column-to-workspace 3; }
    Super+Shift+4                         { move-column-to-workspace 4; }
    Super+Shift+5                         { move-column-to-workspace 5; }
    Super+Shift+6                         { move-column-to-workspace 6; }
    Super+Shift+7                         { move-column-to-workspace 7; }
    Super+Shift+8                         { move-column-to-workspace 8; }
    Super+Shift+9                         { move-column-to-workspace 9; }
    Super+Shift+0                         { move-column-to-workspace 10; }

    Super+TAB                             repeat=false { toggle-overview; }

    // ─── Layout Controls ───
    Super+CTRL+A                          { set-column-width "-5%"; }
    Super+CTRL+D                          { set-column-width "+5%"; }
    Super+CTRL+W                          { set-window-height "-5%"; }
    Super+CTRL+S                          { set-window-height "+5%"; }

    // ─── Superes ───
    Super+F                               { toggle-window-floating; }
    Super+Shift+F                         { toggle-column-tabbed-display; }

    Super+CTRL+E                          { expand-column-to-available-width; }
    Super+ALT+E                           { center-column; }
    Super+E                               { fullscreen-window; }
    Super+Shift+E                         { expand-column-to-available-width; }


    // ─── Screenshots ───

    Alt+Print                             { spawn "noctalia" "msg" "screenshot-annotate"; }
    Shift+Print                           { spawn "noctalia" "msg" "screenshot-region"; }
    Print                                 { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Shift+Ctrl+Print                      { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    // ─── Exit / Power ───
    Super+Shift+O                         { quit; }
}
